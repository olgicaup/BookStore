        text-align: center;
        width: 350px;
        padding: 10px;
        background-color: #de5d83;
        color: #ffc1cc;
        border: dotted;
        border-radius: 10px;
    }
    h3
    {
        text-align: center;
        width: 600px;
        color: #de5d83;
        margin-left: -30px;
    }

    .col-sm-2 {
        border-radius: 10px;
        background-color: #fc8eac;
        padding: 5px;
        margin-top: 5px;
        text-align: center;
    }

    body {
        margin-bottom: 60px;
        background-color: #cee5ee;
