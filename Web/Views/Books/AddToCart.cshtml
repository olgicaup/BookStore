@model Domain.Domain_Models.BookInShoppingCart

<h1>Add book to Shopping cart</h1>

<div class="row">
    <div class="col-4">

        <form asp-action="AddToCartConfirmed">
            <input type="hidden" asp-for="BookId" />

            <div class="form-group">
                <label asp-for="Quantity"></label>
                <input asp-for="Quantity" class="form-control" min="1" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" style="background-color: #e75480;margin-top: 10px" value="Add To Cart" class="btn-info" />
            </div>
        </form>
    </div>
</div>
<style>
    h1 {
        text-align: center;
        width: 600px;
        color: #de5d83;
        margin-left: -30px;
    }
    label {
        border-radius: 10px;
        background-color: #fc8eac;
        padding: 5px;
        text-align: center;
    }
    input {
        margin-top: 5px;
    }
    body {
        margin-bottom: 60px;
        background-color: #cee5ee;
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
</style>