        background-color: #80daeb;
        color: #ff6090;
        border: dotted;
        border-radius: 10px;
        margin-left: 500px;
    }
    .left{
        width: 500px;
        padding: 10px;
    }
    .right {
        margin-left: 700px;
        width: 500px;
        margin-top: -290px;
        padding: 10px;
    }

    .btn{
        margin-left: 800px;
        margin-top: 30px;
        width: 200px;
    }
    body{
        margin-bottom: 60px;
        background-image: url(../create2.jpeg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }
    label {
        border-radius: 10px;
        background-color: #b0e0e6;
        width: 150px;
        padding: 5px;
        text-align: center;
        border-top-color: black;
    } 
    .form-control {
        margin: 5px;
    }
    input{
        border-block-end-color: black;
    }
</style>