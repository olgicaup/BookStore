@model Domain.Domain_Models.Book

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit a Book</h1>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="left">
            <div class="form-group">
                <label asp-for="BookName" class="control-label"></label>
                <input asp-for="BookName" class="form-control" />
                <span asp-validation-for="BookName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookDescription" class="control-label"></label>
                <input asp-for="BookDescription" class="form-control" />
                <span asp-validation-for="BookDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BookImage" class="control-label"></label>
                <input asp-for="BookImage" class="form-control" />
                <span asp-validation-for="BookImage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            </div>
            <div class="right">
            <div class="form-group">
                <label asp-for="Rating" class="control-label"></label>
                <input asp-for="Rating" class="form-control" />
                <span asp-validation-for="Rating" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Author" class="control-label"></label>
                <select asp-for="AuthorId" class="form-control" asp-items="ViewBag.AuthorName"></select>
                <span asp-validation-for="AuthorId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Publisher" class="control-label"></label>
                <select asp-for="PublisherId" class="form-control" asp-items="ViewBag.PublisherName"></select>
                <span asp-validation-for="PublisherId" class="text-danger"></span>
            </div>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <input type="submit" value="Save" style="background-color: #e75480;" class="btn" />
            </div>
        </form>
    </div>
</div>

<div>
    <a style="background-color: #e75480;" class="btn " asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<style>
    h1 {
        text-align: center;
        width: 300px;
        padding: 10px;
        background-color: #de5d83;
        color: #ffc1cc;
        border: dotted;
        border-radius: 10px;
        margin-left: 500px;
    }

    .left {
        width: 500px;
        padding: 10px;
    }

    .right {
        margin-left: 700px;
        width: 500px;
        margin-top: -290px;
        padding: 10px;
    }

    .btn {
        margin-left: 800px;
        margin-top: 30px;
        width: 200px;
    }

    body {
        margin-bottom: 60px;
        background-image: url(../../edit1.jpg);
        background-size: cover;
        background-position: center;
        background-repeat: no-repeat;
    }

    label {
        border-radius: 10px;
        background-color: #ff6090;
        width: 150px;
        padding: 5px;
        text-align: center;
        border-top-color: black;
    }

    .form-control {
        margin: 5px;
    }

    input {
        border-block-end-color: black;
    }
</style>